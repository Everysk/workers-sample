{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Everysk - Create Folder Structure",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/run.py", "create", "${input:workerName}" ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Everysk - DEBUG Worker",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/run.py", "debug", "${input:folderName}", "${input:sampleArgsKey}" ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Everysk - TESTS",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/run.py", "tests", "${input:folderName}" ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Everysk - DELETE Worker",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/run.py", "delete", "${input:templateId}" ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Everysk - DEPLOY Worker",
            "type": "shell",
            "command": "python",
            "args": [ "${workspaceFolder}/run.py", "deploy", "${input:folderName}" ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Everysk - COVERAGE",
            "type": "shell",
            "command": "python",
            "args": [ "${workspaceFolder}/run.py", "coverage" ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Everysk - SHELL",
            "type": "shell",
            "command": "python",
            "args": [ "${workspaceFolder}/run.py", "shell" ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "folderName",
            "type": "promptString",
            "description": "Folder name of the worker template.",
            "default": ""
        },
        {
            "id": "workerName",
            "type": "promptString",
            "description": "Name of the new worker (the wk_ prefix is added automatically).",
            "default": ""
        },
        {
            "id": "sampleArgsKey",
            "type": "promptString",
            "description": "Key from the worker's sample_args.json to use as input.",
            "default": ""
        },
        {
            "id": "templateId",
            "type": "promptString",
            "description": "Worker template id (or 'all' to delete every deployed worker not present locally).",
            "default": ""
        },
    ]
}
