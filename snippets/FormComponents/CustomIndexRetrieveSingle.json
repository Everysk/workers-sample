{
  "body": {
    "id": "custom_index_query",
    "name": "Custom Index",
    "entityType": "custom_index",
    "placeholder": "",
    "tipover": "",
    "paddingLeft": 0,
    "paddingRight": 0,
    "paddingTop": 0,
    "paddingBottom": 0,
    "gridSizeMd": 12,
    "mandatory": true,
    "displayName": true,
    "withoutMessages": false,
    "variantOptions": [
      {
        "label": "Fixed Custom Index",
        "value": "selectCustomIndex"
      },
      {
        "label": "Latest by Tags",
        "value": "tagLatest"
      },
      {
