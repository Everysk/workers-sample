        "defaultValues": {
          "select": {
            "label": "",
            "value": ""
          }
        }
      },
      "tagLatest": {
        "type": "tag",
        "validation": "hashtag",
        "helperText": "Set custom index tags. Retrieves the latest custom index containing the specified tags.",
        "maxLength": 10,
        "defaultValues": {
          "value": []
        }
      },
      "previousWorkers": {
        "type": "nestedAttributes",
        "helperText": "Select a custom index, a custom index ID or a list of tags from a previous worker.",
        "defaultValues": {
          "select": {
            "label": "",
            "value": ""
          }
        },
        "options": [],
        "filterType": [
          "custom_index",
          "string",
          "list"
        ],
        "listFilterType": [
          "string"
        ]
      }
    }
  }
