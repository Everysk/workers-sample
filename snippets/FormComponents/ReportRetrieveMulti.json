{
  "body": [
    {
      "id": "reports_query_list",
      "name": "Report(s)",
      "type": "assembler",
      "addLabel": "Add Report",
      "min": 1,
      "max": 10,
      "paddingLeft": 0,
      "paddingRight": 0,
      "paddingTop": 0,
      "paddingBottom": 0,
      "gridSizeMd": 12,
      "multiple": true,
      "mandatory": false,
      "displayName": false,
      "withoutMessages": 1,
      "fields": [
        {
          "id": "reports_query",
          "name": "Report(s)",
          "entityType": "report",
          "workspace": "reports_query_workspace",
          "tipover": "",
          "paddingLeft": 0,
          "paddingRight": 0,
          "paddingTop": 0,
          "paddingBottom": 0,
          "gridSizeMd": 11,
          "mandatory": true,
          "displayName": true,
          "withoutMessages": false,
          "variantOptions": [
            {
              "label": "Fixed Report",
              "value": "selectReport"
            },
            {
              "label": "Latest by Tags",
              "value": "tagLatest"
            },
            {
              "label": "Latest by Link UID",
              "value": "linkLatest"
            },
            {
              "label": "List by Tags",
              "value": "tagList"
            },
            {
              "label": "List by Link UID",
              "value": "linkList"
            },
            {
              "label": "Upstream Data",
              "value": "previousWorkers"
            }
          ],
          "defaultVariant": "selectReport",
          "variants": {
            "selectReport": {
              "type": "selectRemoteData",
              "resultVariable": "reports",
              "url": "reports",
              "link": "reports",
              "placeholder": "Select an existing report",
              "defaultValues": {
                "select": {
                  "label": "",
                  "value": ""
                }
              }
            },
            "tagLatest": {
              "type": "tag",
              "validation": "hashtag",
              "placeholder": "Set report tags. Retrieves the latest report containing the specified tags",
              "maxLength": 10,
              "defaultValues": {
                "value": []
              }
            },
            "linkLatest": {
              "type": "metaString",
              "placeholder": "Set report link UID. Retrieves the latest report containing the specified link UID",
              "maxLength": 250,
              "defaultValues": {
                "select": {
                  "label": "",
                  "value": ""
                }
              },
              "filterType": [
                "number",
                "string",
                "date"
              ]
            },
            "tagList": {
              "type": "tag",
              "validation": "hashtag",
              "placeholder": "Set report tags. Retrieves a list of reports containing the specified tags",
              "maxLength": 10,
              "defaultValues": {
                "value": []
              }
            },
            "linkList": {
              "type": "metaString",
              "placeholder": "Set report link UID. Retrieves list of reports containing the specified link UID",
              "maxLength": 250,
              "defaultValues": {
                "select": {
                  "label": "",
                  "value": ""
                }
              },
              "filterType": [
                "number",
                "string",
                "date"
              ]
            },
            "previousWorkers": {
              "type": "nestedAttributes",
              "placeholder": "Select a report from a previous worker.",
              "defaultValues": {
                "select": {
                  "label": "",
                  "value": ""
                }
              },
              "options": [],
              "filterType": [
                "report"
              ]
            }
          }
        },
        {
          "id": "reports_query_workspace",
          "name": "Workspace",
          "permission": "workflows.save_source_code",
          "placeholder": "Using current workspace",
          "paddingLeft": 0,
          "paddingRight": 0,
          "paddingTop": 0,
          "paddingBottom": 0,
          "gridSizeMd": 1,
          "variantOptions": [
            {
              "label": "Fixed Workspace",
              "value": "selectWorkspace"
            }
          ],
          "defaultVariant": "selectWorkspace",
          "variants": {
            "selectWorkspace": {
              "type": "selectRemoteData",
              "resultVariable": "workspaces",
              "url": "workspaces",
              "link": "workspaces",
              "helperText": "Select an existing workspace.",
              "icon": true,
              "defaultValues": {
                "select": {
                  "label": "",
                  "value": ""
                }
              }
            }
          }
        }
      ]
    }
  ]
}
