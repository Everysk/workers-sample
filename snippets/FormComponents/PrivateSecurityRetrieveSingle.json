      },
      "previousWorkers": {
        "type": "nestedAttributes",
        "helperText": "Select a private security, a private security ID or a list tags from a previous worker.",
        "defaultValues": {
          "select": {
            "label": "",
            "value": ""
          }
        },
        "options": [],
        "filterType": [
          "private_security",
          "list"
        ],
        "listFilterType": [
          "string"
        ]
      }
    }
  }
