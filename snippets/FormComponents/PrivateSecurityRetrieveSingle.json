{
  "body": {
    "id": "private_security_query",
    "name": "Private Security",
    "entityType": "private_security",
    "placeholder": "",
    "tipover": "",
    "paddingLeft": 0,
    "paddingRight": 0,
    "paddingTop": 0,
    "paddingBottom": 0,
    "gridSizeMd": 12,
    "mandatory": true,
    "displayName": true,
    "withoutMessages": false,
    "variantOptions": [
      {
        "label": "Fixed Private Security",
