{
  "body": {
    "id": "custom_indexes_query_list",
    "name": "Custom Index(es)",
    "type": "assembler",
    "addLabel": "Add Custom Index",
    "min": 1,
    "max": 10,
    "paddingLeft": 0,
    "paddingRight": 0,
    "paddingTop": 0,
    "paddingBottom": 0,
    "gridSizeMd": 12,
    "multiple": true,
    "mandatory": false,
    "displayName": false,
    "withoutMessages": 1,
    "fields": [
      {
        "id": "custom_indexes_query",
        "name": "Custom Index(es)",
        "entityType": "custom_index",
        "tipover": "",
        "paddingLeft": 0,
        "paddingRight": 0,
        "paddingTop": 0,
        "paddingBottom": 0,
        "gridSizeMd": 12,
        "mandatory": true,
        "displayName": true,
        "withoutMessages": false,
        "variantOptions": [
          {
            "label": "Fixed Custom Index",
            "value": "selectCustomIndex"
          },
          {
            "label": "Latest by Tags",
            "value": "tagLatest"
          },
          {
            "label": "List by Tags",
            "value": "tagList"
          },
          {
            "label": "Upstream Data",
            "value": "previousWorkers"
          }
        ],
        "defaultVariant": "selectCustomIndex",
        "variants": {
          "selectCustomIndex": {
            "type": "selectRemoteData",
            "resultVariable": "custom_indexes",
            "url": "custom_indexes",
            "link": "custom_indexes",
            "placeholder": "Select an existing Custom Index",
            "defaultValues": {
              "select": {
                "label": "",
                "value": ""
              }
            }
          },
          "tagLatest": {
            "type": "tag",
            "validation": "hashtag",
            "placeholder": "Set custom index tags. Retrieves the latest custom index containing the specified tags",
            "maxLength": 10,
            "defaultValues": {
              "value": []
            }
          },
          "tagList": {
            "type": "tag",
            "validation": "hashtag",
            "placeholder": "Set custom index tags. Retrieves a list of custom indexes containing the specified tags",
            "maxLength": 10,
            "defaultValues": {
              "value": []
            }
          },
          "previousWorkers": {
            "type": "nestedAttributes",
            "placeholder": "Select a custom index or a list of custom indexes from a previous worker",
            "defaultValues": {
              "select": {
                "label": "",
                "value": ""
              }
            },
            "options": [],
            "filterType": [
              "custom_index",
              "list"
            ],
            "listFilterType": [
              "custom_index"
            ]
          }
        }
      }
    ]
  }
}
