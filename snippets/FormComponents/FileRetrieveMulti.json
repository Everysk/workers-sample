{
  "body": {
    "id": "files_query_list",
    "name": "File(s)",
    "type": "assembler",
    "addLabel": "Add File",
    "min": 1,
    "max": 10,
    "paddingLeft": 0,
    "paddingRight": 0,
    "paddingTop": 0,
    "paddingBottom": 0,
    "gridSizeMd": 12,
    "multiple": true,
    "mandatory": false,
    "displayName": false,
    "withoutMessages": 1,
    "fields": [
      {
        "id": "files_query",
        "name": "File(s)",
        "entityType": "file",
        "workspace": "files_query_workspace",
        "tipover": "",
        "paddingLeft": 0,
        "paddingRight": 0,
        "paddingTop": 0,
        "paddingBottom": 0,
        "gridSizeMd": 11,
        "mandatory": true,
        "displayName": true,
        "withoutMessages": false,
        "variantOptions": [
          {
            "label": "Fixed File",
            "value": "selectFile"
          },
          {
            "label": "Latest by Tags",
            "value": "tagLatest"
          },
          {
            "label": "Latest by Link UID",
            "value": "linkLatest"
          },
          {
            "label": "List by Tags",
            "value": "tagList"
          },
          {
            "label": "List by Link UID",
            "value": "linkList"
          },
          {
            "label": "Upstream Data",
            "value": "previousWorkers"
          }
        ],
        "defaultVariant": "selectFile",
        "variants": {
          "selectFile": {
            "type": "selectRemoteData",
            "resultVariable": "files",
            "url": "files",
            "link": "files",
            "requestParameters": {
              "content_types": []
            },
            "placeholder": "Select an existing file",
            "defaultValues": {
              "select": {
                "label": "",
                "value": ""
              }
            }
          },
          "tagLatest": {
            "type": "tag",
            "validation": "hashtag",
            "placeholder": "Set file tags. Retrieves the latest file containing the specified tags",
            "maxLength": 10,
            "defaultValues": {
              "value": []
            }
          },
          "linkLatest": {
            "type": "metaString",
            "placeholder": "Set file link UID. Retrieves the latest file containing the specified link UID",
            "maxLength": 250,
            "defaultValues": {
              "select": {
                "label": "",
                "value": ""
              }
            },
            "filterType": [
              "number",
              "string",
              "date"
            ]
          },
          "tagList": {
            "type": "tag",
            "validation": "hashtag",
            "placeholder": "Set file tags. Retrieves all files containing the specified tags",
            "maxLength": 10,
            "defaultValues": {
              "value": []
            }
          },
          "linkList": {
            "type": "metaString",
            "placeholder": "Set file link UID. Retrieves list of files containing the specified link UID",
            "maxLength": 250,
            "defaultValues": {
              "select": {
                "label": "",
                "value": ""
              }
            },
            "filterType": [
              "number",
              "string",
              "date"
            ]
          },
          "previousWorkers": {
            "type": "nestedAttributes",
            "placeholder": "Select a file or a list of files from a previous worker",
            "defaultValues": {
              "select": {
                "label": "",
                "value": ""
              }
            },
            "options": [],
            "filterType": [
              "list",
              "file"
            ],
            "listFilterType": [
              "file"
            ]
          }
        }
      },
      {
        "id": "files_query_workspace",
        "name": "Workspace",
        "permission": "workflows.save_source_code",
        "placeholder": "Using current workspace",
        "paddingLeft": 0,
        "paddingRight": 0,
        "paddingTop": 0,
        "paddingBottom": 0,
        "gridSizeMd": 1,
        "variantOptions": [
          {
            "label": "Fixed Workspace",
            "value": "selectWorkspace"
          }
        ],
        "defaultVariant": "selectWorkspace",
        "variants": {
          "selectWorkspace": {
            "type": "selectRemoteData",
            "resultVariable": "workspaces",
            "url": "workspaces",
            "link": "workspaces",
            "helperText": "Select an existing workspace.",
            "icon": true,
            "defaultValues": {
              "select": {
                "label": "",
                "value": ""
              }
            }
          }
        }
      }
    ]
  }
}
