{
  "body": [
    {
      "id": "files_query",
      "name": "File(s)",
      "entityType": "file",
      "workspace": "files_query_workspace",
      "placeholder": "",
      "tipover": "",
      "paddingLeft": 0,
      "paddingRight": 0,
      "paddingTop": 0,
      "paddingBottom": 0,
      "gridSizeMd": 11,
      "mandatory": true,
      "displayName": true,
      "withoutMessages": false,
      "variantOptions": [
        {
          "label": "List by Tags",
          "value": "tagList"
        },
        {
          "label": "List by Link UID",
          "value": "linkList"
        },
        {
          "label": "Upstream Data",
          "value": "previousWorkers"
        }
      ],
      "defaultVariant": "tagList",
      "variants": {
        "tagList": {
          "type": "tag",
          "validation": "hashtag",
          "helperText": "Set file tags. Retrieves a list of files containing the specified tags.",
          "maxLength": 10,
          "defaultValues": {
            "value": []
          }
        },
        "linkList": {
          "type": "metaString",
          "helperText": "Set file link UID. Retrieves list of files containing the specified link UID.",
          "maxLength": 250,
          "defaultValues": {
            "select": {
              "label": "",
              "value": ""
            }
          },
          "filterType": [
            "number",
            "string",
            "date"
          ]
        },
        "previousWorkers": {
          "type": "nestedAttributes",
          "helperText": "Select a list of files, a link UID or a list tags from a previous worker.",
          "defaultValues": {
            "select": {
              "label": "",
              "value": ""
            }
          },
          "options": [],
          "filterType": [
            "string",
            "list"
          ],
          "listFilterType": [
            "file",
            "string"
          ]
        }
      }
    },
    {
      "id": "files_query_workspace",
      "name": "Workspace",
      "permission": "workflows.save_source_code",
      "placeholder": "Using current workspace",
      "paddingLeft": 0,
      "paddingRight": 0,
      "paddingTop": 0,
      "paddingBottom": 0,
      "gridSizeMd": 1,
      "variantOptions": [
        {
          "label": "Fixed Workspace",
          "value": "selectWorkspace"
        }
      ],
      "defaultVariant": "selectWorkspace",
      "variants": {
        "selectWorkspace": {
          "type": "selectRemoteData",
          "resultVariable": "workspaces",
          "url": "workspaces",
          "link": "workspaces",
          "helperText": "Select an existing workspace.",
          "icon": true,
          "defaultValues": {
            "select": {
              "label": "",
              "value": ""
            }
          }
        }
      }
    }
  ]
}
