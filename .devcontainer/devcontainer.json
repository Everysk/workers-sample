// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.224.2/containers/python-3
{
	"name": "Workers Sample",
	"build": {
		"dockerfile": "${localWorkspaceFolder}/.devcontainer/Dockerfile",
		"context": "${localWorkspaceFolder}"
	},
    "customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
			 	"ms-python.python"
			],
			// Set *default* container specific settings.json values on container create.
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python3",
				// https://github.com/microsoft/vscode/issues/207813#issuecomment-2020656014
				"extensions.verifySignature": false
			}
		}
	},
	// Script that prepares the commit signing key mount sources on the host.
	"initializeCommand": "${localWorkspaceFolder}/.devcontainer/setup.sh",
	// Wait for the host-side setup before the container is built.
	"waitFor": "initializeCommand",

	// Commit signing key, mounted file by file so the remaining keys in ~/.ssh stay on the host.
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/git-signing,target=/root/.ssh/git-signing,type=bind,consistency=cached",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/git-signing.pub,target=/root/.ssh/git-signing.pub,type=bind,consistency=cached"
	],

	// Turn on commit signing, guarded on a non-empty public key.
	//
	// This must stay in "postStartCommand". VS Code copies the host ~/.gitconfig
	// (your user.name/user.email) into the container only when /root/.gitconfig
	// holds no configuration yet, and it makes that check *after* onCreateCommand
	// and postCreateCommand. Writing the signing config in either of those hooks
	// makes VS Code skip the copy, and the container ends up with no git identity.
	// The container also runs with --rm, so the config is written again on each start.
	"postStartCommand": {
		"commitSigning": "if [ -s /root/.ssh/git-signing.pub ]; then git config --global gpg.format ssh && git config --global user.signingkey /root/.ssh/git-signing.pub && git config --global commit.gpgsign true; else echo '⚠️  No commit signing key. Commits stay unsigned and protected branches reject them.'; fi"
	},

	"workspaceMount": "source=${localWorkspaceFolder},target=/var/app,type=bind,consistency=cached",
	"workspaceFolder": "/var/app",

	// An array of Docker CLI arguments that should be used when running the container. Defaults to [].
	// --rm: will delete the container after exit.
	"runArgs": [
		"--rm"
	]
}
